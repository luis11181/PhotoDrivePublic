# PhotoDrive configuration
# Copy this file to .env, replace every REQUIRED value, then run:
#   install -m 600 .env.example .env
#   ./photodrive setup

# -----------------------------------------------------------------------------
# REQUIRED: application address and first owner
# -----------------------------------------------------------------------------

# Exact browser origin, with no trailing slash. Plain HTTP is accepted only for
# localhost/private-network addresses. Use HTTPS for a public domain.
PHOTODRIVE_ORIGIN=http://localhost:8080

# Host port mapped to the container. Keep this aligned with the origin above.
PHOTODRIVE_PORT=8080

# The first Owner account. This is used only while no active Owner exists.
PHOTODRIVE_OWNER_EMAIL=you@example.com

# At least 12 characters with upper/lowercase, a number, and a symbol.
# Single quotes keep special characters literal in Docker Compose.
PHOTODRIVE_OWNER_PASSWORD='replace-with-a-one-time-strong-password'

# Generate with: openssl rand -base64 48
PHOTODRIVE_JWT_SECRET=replace-with-at-least-32-random-bytes

# -----------------------------------------------------------------------------
# REQUIRED: private S3 storage
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_REGION=us-east-1

# These globally unique buckets must be different. `./photodrive setup` creates
# and hardens them when the configured AWS identity has permission to do so.
PHOTODRIVE_ORIGINALS_BUCKET=replace-with-unique-originals-bucket
PHOTODRIVE_BACKUPS_BUCKET=replace-with-unique-backups-bucket

# -----------------------------------------------------------------------------
# OPTIONAL: authentication
# -----------------------------------------------------------------------------

PHOTODRIVE_PASSWORD_LOGIN=true

# Google OAuth is optional. Register PHOTODRIVE_ORIGIN as an authorized
# JavaScript origin and leave these empty to offer password login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Temporary AWS sessions may set this value.
AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL: safe defaults for most homes
# -----------------------------------------------------------------------------

# IANA name such as UTC, America/Bogota, or Europe/London.
PHOTODRIVE_TIME_ZONE=UTC

# Local delivery cache: 10 GiB total, and automatically cache originals up to
# 512 MiB after a complete verified read.
PHOTODRIVE_CACHE_MAX_BYTES=10737418240
PHOTODRIVE_CACHE_FILE_MAX_BYTES=536870912

# Verified database backups run every 12 hours and remote sets expire after
# 90 days. The local Docker volume retains the newest 14 snapshots.
PHOTODRIVE_BACKUP_INTERVAL_HOURS=12
PHOTODRIVE_BACKUP_RETENTION_DAYS=90
PHOTODRIVE_LOCAL_BACKUP_COUNT=14

# Optional comma-separated IP/CIDR allowlist. Empty means authentication is the
# application boundary. Example: 192.168.1.0/24,100.64.0.0/10
PHOTODRIVE_ALLOWED_NETWORKS=

# Set true only when an HTTPS reverse proxy is directly in front of PhotoDrive.
# The trusted network must identify that proxy, never the whole internet.
PHOTODRIVE_BEHIND_PROXY=false
PHOTODRIVE_TRUSTED_PROXY_NETWORK=172.16.0.0/12

# Keep recovery manifests enabled. Portable JSONL exports add another recovery
# format but consume more backup space.
PHOTODRIVE_RECOVERY_MANIFESTS=true
PHOTODRIVE_PORTABLE_EXPORTS=false

PHOTODRIVE_LOG_LEVEL=Information
