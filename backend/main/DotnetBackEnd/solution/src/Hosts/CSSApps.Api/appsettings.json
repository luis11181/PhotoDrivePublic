{
  "Urls": "http://0.0.0.0:8080",
  "AllowedHosts": "localhost",
  "Security": {
    "RequireHttps": false,
    "DataProtectionKeysDirectory": "/data/keys"
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:8080"
    ],
    "AllowedHttpHostsAnyPort": []
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "AccessControl": {
    "IpAllowlist": {
      "Enabled": false,
      "AllowedNetworks": []
    }
  },
  "ConnectionStrings": {
    "UsersModule": "Data Source=/data/databases/photodrive.users.db;Foreign Keys=True",
    "MediaCatalog": "Data Source=/data/databases/photodrive.catalog.db;Foreign Keys=True"
  },
  "MediaStorage": {
    "LocalDisk": {
      "StagingDirectory": "/data/cache/staging",
      "ThumbnailDirectory": "/data/cache/thumbnails",
      "OriginalCacheDirectory": "/data/cache/originals",
      "OriginalCacheMaxBytes": 10737418240,
      "OriginalCacheAutomaticMaxFileBytes": 536870912,
      "BackupDirectory": "/data/backups",
      "BackupRetainedSnapshotCount": 14
    },
    "Backups": {
      "ScheduleEnabled": true,
      "AnchorLocalTime": "02:00",
      "IntervalHours": 12,
      "TimeZoneId": "UTC",
      "RemoteRetentionDays": 90
    },
    "BackupStrategies": {
      "RecoveryManifestsEnabled": true,
      "PortableJsonExportsEnabled": false
    },
    "ImageToolPath": "convert",
    "ImageIdentifyToolPath": "identify",
    "VideoMetadataToolPath": "ffprobe",
    "VideoThumbnailToolPath": "ffmpeg",
    "FileTypeToolPath": "file",
    "S3": {
      "BucketName": "replace-originals-bucket",
      "ProfileName": "photodrive",
      "Region": "us-east-1"
    },
    "S3Backups": {
      "BucketName": "replace-backups-bucket",
      "ProfileName": "photodrive",
      "Region": "us-east-1"
    }
  },
  "JwtSettings": {
    "AccessTokenSecret": "replace-with-at-least-32-random-bytes",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationMinutes": 10080,
    "Issuer": "http://localhost:8080",
    "Audience": "http://localhost:8080",
    "ValidateAudience": true,
    "ValidateIssuer": true
  },
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "UserInfoUrl": "https://openidconnect.googleapis.com/v1/userinfo"
    }
  },
  "FamilyAuthentication": {
    "PasswordLoginEnabled": true,
    "PasswordResetLifetimeMinutes": 30,
    "BootstrapOwner": {
      "Email": "owner@example.com",
      "InitialPassword": ""
    }
  },
  "feature_management": {
    "feature_flags": [
      {
        "id": "RefreshTokens",
        "enabled": true
      }
    ]
  },
  "UserPermissions": {
    "CacheTimeInMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
