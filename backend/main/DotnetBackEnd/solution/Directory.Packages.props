<Project>
    <PropertyGroup>
        <!--<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>-->
    </PropertyGroup>
    <ItemGroup Condition="$(MSBuildProjectExtension) == '.csproj'">
