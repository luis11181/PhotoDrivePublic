{
  "name": "new-media-explorer-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:live": "node ../scripts/smoke/live-media-flow.cjs",
