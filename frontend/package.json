    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "20.17.50",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "eslint": "9.27.0",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.5",
    "playwright": "1.59.1",
    "serve": "14.2.6",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
